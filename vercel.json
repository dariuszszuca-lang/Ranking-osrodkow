{
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug/index.html"
    },
    {
      "source": "/blog/:slug/",
      "destination": "/blog/:slug/index.html"
    },
    {
      "source": "/((?!blog|sitemap.xml|robots.txt).*)",
      "destination": "/index.html"
    }
  ]
}
